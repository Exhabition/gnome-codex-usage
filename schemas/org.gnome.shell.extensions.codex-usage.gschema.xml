<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <enum id="org.gnome.shell.extensions.codex-usage.PanelDisplay">
    <value nick="remaining" value="0"/>
    <value nick="used" value="1"/>
    <value nick="today" value="2"/>
  </enum>

  <schema id="org.gnome.shell.extensions.codex-usage" path="/org/gnome/shell/extensions/codex-usage/">
    <key name="show-icon" type="b">
      <default>true</default>
      <summary>Show the panel icon</summary>
    </key>
    <key name="panel-display" enum="org.gnome.shell.extensions.codex-usage.PanelDisplay">
      <default>'remaining'</default>
      <summary>Value displayed in the top panel</summary>
    </key>
    <key name="update-interval" type="u">
      <range min="30" max="900"/>
      <default>120</default>
      <summary>Background refresh interval in seconds</summary>
    </key>
    <key name="codex-command" type="s">
      <default>''</default>
      <summary>Codex executable name or absolute path</summary>
    </key>
    <key name="visible-fields" type="as">
      <default>['today', 'week', 'lifetime', 'streak', 'credits', 'resets', 'resetExpiry']</default>
      <summary>Usage fields shown in the menu</summary>
    </key>
    <key name="field-order" type="as">
      <default>['today', 'week', 'lifetime', 'streak', 'credits', 'resets', 'resetExpiry']</default>
      <summary>Usage field order in the menu</summary>
    </key>
  </schema>
</schemalist>
